#!/usr/bin/env bash
# Is this clone and machine ready to build, test and commit? (AGENTS.md,
# "Setup".) Prints one line per check, PASS / WARN / FAIL, and the exact
# fix for each that isn't PASS. Exits 1 when something FAILs. Reads no
# secrets: of chimera.local.toml only whether it exists.
# Windows: scripts\doctor.ps1.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 2
fails=0
pass() { printf 'PASS  %s\n' "$1"; }
warn() { printf 'WARN  %s\n      fix: %s\n' "$1" "$2"; }
fail() { printf 'FAIL  %s\n      fix: %s\n' "$1" "$2"; fails=$((fails + 1)); }

# Git: identity, hooks, line endings.
name=$(git config --local user.name 2>/dev/null || true)
email=$(git config --local user.email 2>/dev/null || true)
if [ "$name" = r0pi0x ] && [ "$email" = 339403489+r0pi0x@users.noreply.github.com ]; then
    pass "git identity (repo-local)"
else
    fail "git identity is '${name:-unset} <${email:-unset}>' (the pre-push hook refuses it)" "tools/setup"
fi
if [ "$(git config core.hooksPath 2>/dev/null)" = .githooks ]; then
    pass "hooks (core.hooksPath .githooks)"
else
    fail "hooks not enabled" "tools/setup   (or: git config core.hooksPath .githooks)"
fi
crlf=$(git ls-files --eol 2>/dev/null | awk '$2 ~ /crlf/' | head -3)
if [ -z "$crlf" ]; then
    pass "line endings (LF in the working tree)"
else
    fail "CRLF files in the working tree, e.g. $(echo "$crlf" | awk '{print $NF}' | paste -sd' ' -)" \
        "git config core.autocrlf false && git rm -r --cached -q . && git reset --hard   (commit or stash first)"
fi
case "${TZ:-}" in
    UTC|UTC0|Etc/UTC) pass "TZ=UTC in this shell" ;;
    *) warn "TZ is not UTC in this shell (commit dates must be UTC)" "export TZ=UTC   (or TZ=UTC git commit ...)" ;;
esac

# Disk: the caches stop writing below the floor (tools/disk-free.sh).
# shellcheck source=/dev/null
. tools/disk-free.sh
if disk_check .; then
    pass "free disk space ($DISK_FREE_GB GB free of $DISK_TOTAL_GB; floor $DISK_FLOOR_GB)"
else
    warn "low disk space: $DISK_FREE_GB GB free of $DISK_TOTAL_GB (below the $DISK_FLOOR_GB GB floor: the map and asset caches skip their writes, builds may fail)" \
        "tools/clean-worktrees.sh (trims build folders), or cargo clean in checkouts you don't use; CHIMERA_DISK_FLOOR_GB moves the floor"
fi

# Toolchain.
need=$(sed -n 's/^rust-version = "\(.*\)"/\1/p' Cargo.toml | head -1)
if have=$(rustc --version 2>/dev/null | awk '{print $2}'); then
    if [ "$(printf '%s\n%s\n' "$need" "$have" | sort -V | head -1)" = "$need" ]; then
        pass "rustc $have (needs $need)"
    else
        fail "rustc $have is older than $need" "rustup update stable"
    fi
else
    fail "no rustc" "install Rust from https://rustup.rs"
fi
command -v cargo >/dev/null 2>&1 && pass "cargo" || fail "no cargo" "install Rust from https://rustup.rs"
if command -v pkg-config >/dev/null 2>&1; then
    for lib in alsa libudev; do
        pkg-config --exists "$lib" && pass "$lib development files" ||
            fail "missing $lib development files (Bevy needs them)" \
                "see https://github.com/bevyengine/bevy/blob/main/docs/linux_dependencies.md (e.g. apt install libasound2-dev libudev-dev)"
    done
else
    warn "no pkg-config: can't check ALSA/udev development files" "install pkg-config"
fi
cargo nextest --version >/dev/null 2>&1 && pass "cargo-nextest" ||
    warn "no cargo-nextest (optional; the full suite runs 2x faster with it)" "cargo install cargo-nextest --locked"
cargo hakari --version >/dev/null 2>&1 && pass "cargo-hakari" ||
    warn "no cargo-hakari (needed only after changing a dependency)" "cargo install cargo-hakari --locked"
command -v sccache >/dev/null 2>&1 || [ -x "$HOME/.local/sccache-0.19/bin/sccache" ] && pass "sccache" ||
    warn "no sccache (optional; tools/agent-env.sh uses it for shared builds)" \
        "cargo install sccache --locked --no-default-features --root ~/.local/sccache-0.19"
command -v mold >/dev/null 2>&1 && pass "mold linker" ||
    warn "no mold (optional; links tests ~2x faster, .cargo/config.toml says how)" "install mold from your package manager"

# Local config and game installs (only existence is checked).
if [ -f chimera.local.toml ] || [ -f mashup.local.toml ]; then
    pass "chimera.local.toml present (contents not read)"
else
    warn "no chimera.local.toml (optional: install paths, Combat Arms keys; most tests don't need it)" \
        "cp chimera.local.example.toml chimera.local.toml and edit it yourself"
fi
css=""
for root in "${CHIMERA_STEAM_ROOT:-}" "$HOME/.steam/steam" "$HOME/.steam/root" "$HOME/.local/share/Steam" \
    "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"; do
    [ -n "$root" ] && [ -f "$root/steamapps/libraryfolders.vdf" ] || continue
    libs=$(sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"/\1/p' "$root/steamapps/libraryfolders.vdf")
    for lib in "$root" $libs; do
        [ -f "$lib/steamapps/appmanifest_240.acf" ] && css="$lib" && break 2
    done
done
settings=${CHIMERA_SETTINGS:-$HOME/.local/share/chimera/settings.toml}
if [ -n "$css" ]; then
    pass "Counter-Strike: Source found in the Steam library $css"
elif [ -f "$settings" ]; then
    pass "Counter-Strike: Source: a saved install path may be in $settings"
else
    warn "Counter-Strike: Source (Steam app 240) not found (tests that need it skip; the apps need it)" \
        "install it with Steam, or set [games.cs_source] path in chimera.local.toml, or run chimera_install <folder> in the game's console"
fi
if [ -n "${CHIMERA_ASSET_URL:-}" ]; then
    pass "asset service configured (CHIMERA_ASSET_URL)"
fi

# Ports the game and tools use by default.
if command -v ss >/dev/null 2>&1; then
    for p in udp:27015 udp:28930 tcp:15702; do
        proto=${p%%:*} port=${p##*:}
        if ss -lnH --"$proto" "sport = :$port" 2>/dev/null | grep -q .; then
            warn "$proto port $port is in use (another game, server or agent)" \
                "tool runs pick free ports by themselves; else pass -port <n> / CHIMERA_REMOTE_PORT=<n>, or find the owner: ss -lnp${proto:0:1} 'sport = :$port'"
        else
            pass "$proto port $port free"
        fi
    done
fi

if [ "$fails" -gt 0 ]; then
    echo "doctor: $fails check(s) failed."
    exit 1
fi
echo "doctor: ready."
