# A stand-in pistol made by tools/new-game so the game plays in the sandbox
# from day one (`rung __ID__:weapon_standin`). Not any real gun's numbers:
# replace it with the game's guns from specs/__ID__/weapons.md (one
# document per gun; docs/weapon-data.md; the add-weapon-from-data skill).
id = "__ID__:weapon_standin"
base = "__ID__:base"
class = "pistol"
slot = 1
draw = 0.5
weight = 2

[trigger]
automatic = false
cycle = 0.15
timing = "carry_over"

[magazine]
