# TF2's stock Flame Thrower's sounds as another player hears them
# (specs/tf2/effects.md 14.2; the Pyro's own view: flame_sounds.tf2): a
# puppet Pyro (stock guns) watched in third person (`spec_mode 5`) holds
# attack 15 ticks, 67 ticks and 400 ticks (`bot_forceattack`), after a
# holster and redeploy (`bot_selectweaponslot`). `sv_soundemitter_trace 1`
# to tf/console.log with a marker `echo fb_t<n>` every 5 ticks, and
# `snd_show 1` photographed by the snaps `fb_<tick>`; `host_framerate
# 0.015` makes each frame one tick, `wait 2` is one frame. Generated.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/flame_sounds_bot.tf2 --out <dir>
mp_disable_respawn_times 1
tf_weapon_criticals 0
host_framerate 0
bot_kick all
sleep 3
bot -name FT -class pyro -team blue
sleep 4
bot_teleport FT 0 0 0 0 90 0
sleep 2
jointeam spectator
sleep 2
spec_player FT
sleep 1
spec_mode 5
sleep 2
cl_drawhud 1
r_drawvgui 1
snd_show 1
sv_soundemitter_trace 1
host_framerate 0.015
echo fb_t0
wait 10
echo fb_t5
wait 10
echo fb_t10
snap fb_10
wait 10
echo fb_t15
wait 10
echo fb_t20
bot_selectweaponslot 1
wait 6
snap fb_23
wait 4
echo fb_t25
wait 10
