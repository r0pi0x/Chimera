# A Soldier's rocket bursting on a Heavy 300 units down 2fort's bridge (real TF2;
# ours: air.scene): the movie's frames from the shot, 60 a second.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/air.tf2 --out <dir>
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 60
tf_weapon_criticals 0
host_framerate 0
bot_kick all
sleep 1
jointeam red
sleep 1
joinclass soldier
kill
sleep 7
use tf_weapon_rocketlauncher
bot -name AirHeavy -class heavy -team blue
sleep 5
bot_teleport AirHeavy 0 0 0 0 270 0
sleep 2
bot_teleport AirHeavy 0 0 0 0 270 0
sleep 2
setpos 0 -300 0
setang 0 90 0
sleep 3
shot air_idle
host_framerate 0.016667
movie air
wait 2
+attack
wait 2
-attack
wait 100
endmovie
host_framerate 0
bot_kick all
