# First-person muzzle flashes of TF2's bullet guns on 2fort's bridge (real TF2;
# ours: muzzle.scene), at 60 frames a second (host_framerate 1/60: Source's
# particle drag is per frame). Two bursts per gun, the second a frame later,
# a snap every 2 frames: `<gun>_a00` at frames 1, 3, 5... after +attack,
# `<gun>_b00` at 2, 4, 6...; `tf2ref.py onset` names the frames after the shot.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/muzzle.tf2 --out <dir>
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 30
cl_ragdoll_fade_time 0
cl_ragdoll_forcefade 1
kick P1
jointeam red
# scattergun
joinclass scout
kill
sleep 7
setpos 0 0 0
setang 0 90 0
use tf_weapon_scattergun
sleep 3
shot scattergun_idle
host_framerate 0.016667
+attack
wait 1
snap scattergun_a00
wait 2
snap scattergun_a01
wait 2
snap scattergun_a02
wait 2
snap scattergun_a03
wait 2
snap scattergun_a04
wait 2
snap scattergun_a05
wait 2
snap scattergun_a06
wait 2
snap scattergun_a07
wait 2
-attack
-attack2
wait 2
host_framerate 0
sleep 1.5
host_framerate 0.016667
+attack
wait 2
snap scattergun_b00
wait 2
snap scattergun_b01
wait 2
snap scattergun_b02
wait 2
snap scattergun_b03
wait 2
snap scattergun_b04
wait 2
snap scattergun_b05
wait 2
snap scattergun_b06
wait 2
snap scattergun_b07
wait 2
-attack
-attack2
wait 2
host_framerate 0
sleep 1.5
