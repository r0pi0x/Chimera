# First-person muzzle flashes of TF2's bullet guns on 2fort's bridge (real TF2;
# ours: muzzle.scene). Stepped with host_framerate 0.002 (2 ms a frame), a snap
# every 2 frames; `tf2ref.py onset` finds the shot's frame and names the moments:
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/muzzle.tf2 --out <dir>
#   for g in scattergun pistol shotgun smg revolver minigun; do tools/tf2ref/tf2ref.py onset --dir <dir> \
#     --prefix ${g}_f --offsets 0,2,7,15 --names ${g}_2ms,${g}_10ms,${g}_30ms,${g}_62ms; done
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 30
# scattergun
joinclass scout
sleep 7
setpos 0 0 0
setang 0 90 0
use tf_weapon_scattergun
sleep 3
shot scattergun_idle
host_framerate 0.002
+attack
wait 2
snap scattergun_f00
wait 2
snap scattergun_f01
wait 2
snap scattergun_f02
wait 2
snap scattergun_f03
wait 2
snap scattergun_f04
wait 2
snap scattergun_f05
wait 2
snap scattergun_f06
wait 2
snap scattergun_f07
wait 2
snap scattergun_f08
wait 2
snap scattergun_f09
wait 2
snap scattergun_f10
wait 2
snap scattergun_f11
wait 2
snap scattergun_f12
wait 2
snap scattergun_f13
wait 2
snap scattergun_f14
wait 2
snap scattergun_f15
wait 2
snap scattergun_f16
wait 2
snap scattergun_f17
wait 2
snap scattergun_f18
wait 2
snap scattergun_f19
wait 2
snap scattergun_f20
wait 2
snap scattergun_f21
wait 2
snap scattergun_f22
wait 2
snap scattergun_f23
wait 2
snap scattergun_f24
wait 2
snap scattergun_f25
wait 2
snap scattergun_f26
wait 2
snap scattergun_f27
wait 2
snap scattergun_f28
wait 2
snap scattergun_f29
wait 2
snap scattergun_f30
wait 2
snap scattergun_f31
wait 2
snap scattergun_f32
wait 2
snap scattergun_f33
wait 2
snap scattergun_f34
wait 2
snap scattergun_f35
wait 2
snap scattergun_f36
wait 2
snap scattergun_f37
wait 2
snap scattergun_f38
wait 2
snap scattergun_f39
-attack
-attack2
wait 2
host_framerate 0
sleep 1
