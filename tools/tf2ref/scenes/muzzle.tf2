# First-person muzzle flashes of TF2's bullet guns on 2fort's bridge (real TF2;
# ours: muzzle.scene), at 60 frames a second (host_framerate 1/60: Source's
# particle drag is per frame), every rendered frame recorded (`movie`):
# `<gun>_00.png` is the frame before +attack, the shot shows one or two
# frames later (`tf2ref.py onset --prefix <gun>_ --base <gun>_idle`).
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/muzzle.tf2 --out <dir>
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 30
cl_ragdoll_fade_time 0
cl_ragdoll_forcefade 1
kick P1
jointeam red
# scattergun
joinclass scout
kill
sleep 7
setpos 0 0 0
setang 0 90 0
use tf_weapon_scattergun
sleep 3
shot scattergun_idle
host_framerate 0.016667
movie scattergun
wait 2
+attack
wait 20
-attack
-attack2
endmovie
wait 2
host_framerate 0
sleep 1.5
# pistol
joinclass engineer
kill
sleep 7
setpos 0 0 0
setang 0 90 0
use tf_weapon_pistol
sleep 3
shot pistol_idle
host_framerate 0.016667
movie pistol
wait 2
+attack
wait 20
-attack
-attack2
endmovie
wait 2
host_framerate 0
sleep 1.5
