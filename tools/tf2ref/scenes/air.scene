# Ours for air.tf2: a protected Heavy target 7.6 m (300 units) ahead, our
# rocket stepped at host_timescale 0.02, a picture each 1/60 s of game time.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/air.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
rung tf2:tf_weapon_rocketlauncher
wait 2
wait_for idle 3000
wait 60
target remove all
setpos 0 -300 0
setang 0 90 0
wait 30
target add tf2:heavy 7.6 still protect
wait 240
setpos 0 -300 0
setang 0 90 0
wait 60
shot air_idle
host_timescale 0.02
wait 3
+attack
wait_for shot 3000
-attack
gwait 0.0167
shot air_f01
