# Ours for anim2.tf2: each class as a sandbox target facing us, idle with
# each slot's gun 150 units (3.81 m) ahead, then with its primary 300
# (7.62 m) ahead crouched, jumping (0.15 and 0.4 s after `jump`) and
# running at us (`run forward`, photographed as it passes home; no TF2 pair);
# we stand at 0 -300 0 as an Engineer with no view model, then the camera
# stays (`chimera_freecam 2`) and our body steps out of sight.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/anim2.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
r_drawviewmodel 0
rung tf2:tf_weapon_wrench
wait 2
wait_for idle 3000
# scout
chimera_freecam 0
target remove all
wait 30
setpos 0 -300 0
setang 0 90 0
wait 30
target add tf2:scout 7.62 still protect
target set all gun tf2:tf_weapon_scattergun
wait 240
chimera_freecam 0
wait 2
setpos 0 -150 0
setang 0 90 0
wait 30
chimera_freecam 2
wait 2
setpos 0 -700 0
wait 10
shot h_scout_0
chimera_freecam 0
wait 2
setpos 0 -300 0
setang 0 90 0
wait 30
chimera_freecam 2
wait 2
setpos 0 -700 0
wait 10
target set all crouch
gwait 1.5
shot m_scout_crouch
target set all nocrouch
gwait 1
target set all jump
gwait 0.15
shot m_scout_jump1
gwait 0.25
shot m_scout_jump2
target set all nojump
gwait 2
target set all run forward
gwait 0.49
shot m_scout_run
target set all still
gwait 1
chimera_freecam 0
wait 2
setpos 0 -300 0
setang 0 90 0
wait 30
chimera_freecam 2
wait 2
setpos 0 -700 0
wait 10
target set all gun tf2:tf_weapon_pistol_scout
wait 240
chimera_freecam 0
wait 2
setpos 0 -150 0
setang 0 90 0
wait 30
chimera_freecam 2
wait 2
setpos 0 -700 0
wait 10
shot h_scout_1
target set all gun tf2:tf_weapon_bat
wait 240
chimera_freecam 0
wait 2
setpos 0 -150 0
setang 0 90 0
wait 30
chimera_freecam 2
wait 2
setpos 0 -700 0
wait 10
shot h_scout_2
