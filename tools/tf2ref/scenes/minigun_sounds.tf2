# TF2's stock Minigun's sound timings (specs/tf2/minigun.md 4.4; ours:
# games/tf2 tests/it/minigun.rs): a puppet bot (stock guns; `-class heavy`:
# `heavyweapons` gave it a random class) holds attack 200 ticks (3.0 s)
# and lets go, with `sv_soundemitter_trace 1` printing every sound emitted
# to the console (tf/console.log with -condebug), `host_framerate 0.015`
# making each frame one tick, and a marker `echo mg_t<n>` every 5 ticks
# (`wait 10`: `wait 2` is one frame on this listen server) to place them.
# We watch it in third person (`spec_mode 5`): a client turns another's
# barrel only while it draws the gun, and an unturned barrel makes the
# wind-down silent (minigun.md 4.3, 6). Generated: one line per marker.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/minigun_sounds.tf2 --out <dir>
mp_disable_respawn_times 1
tf_weapon_criticals 0
host_framerate 0
bot_kick all
sleep 3
bot -name MG -class heavy -team blue
sleep 4
bot_teleport MG 0 0 0 0 90 0
sleep 2
jointeam spectator
sleep 2
spec_player MG
sleep 1
spec_mode 5
sleep 2
sv_soundemitter_trace 1
host_framerate 0.015
echo mg_t0
bot_forceattack 1
wait 10
echo mg_t5
wait 10
echo mg_t10
wait 10
echo mg_t15
wait 10
echo mg_t20
wait 10
echo mg_t25
wait 10
echo mg_t30
wait 10
echo mg_t35
wait 10
echo mg_t40
wait 10
echo mg_t45
wait 10
