# Ours for stickies.tf2: one uncharged sticky down 2fort's bridge onto its
# floor (the launch, the trail, the landing, the armed pulse at 0.8 s),
# a picture every 1/30 s of game time for 1.6 s, then the detonation
# (attack2) a picture every 1/60 s.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/stickies.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
rung tf2:tf_weapon_pipebomblauncher
wait 2
wait_for idle 3000
wait 60
setpos 0 -300 0
setang 30 90 0
wait 90
shot sticky_idle
# held 0.1 s of game time (the charge's start): ~937 units/s
host_timescale 0.02
wait 3
+attack
gwait 0.1
-attack
wait_for shot 3000
gwait 0.0333
shot sticky_f000
gwait 0.0333
shot sticky_f001
gwait 0.0333
shot sticky_f002
