shot wall_f18
gwait 0.0167
shot wall_f19
gwait 0.0167
shot wall_f20
host_timescale 1
wait 30
rung tf2:tf_weapon_smg
wait 2
wait_for idle 3000
wait 60
setpos 0 -300 0
setang 0 90 0
wait 30
target add tf2:heavy 3.8 still
wait 240
setpos 0 -300 0
setang 10 90 0
wait 90
shot blood_idle
host_timescale 0.02
wait 3
+attack
wait_for shot 3000
-attack
