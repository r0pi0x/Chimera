# Ours for impacts.tf2: an SMG round into the bridge's side wall
# (`wall`), into a Heavy target 150 units down the bridge
# (`blood`), a Wrench swing at the side wall (`wrench`); a picture every
# 1/60 s of game time from the shot.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/impacts.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
target remove all
rung tf2:tf_weapon_smg
wait 2
wait_for idle 3000
wait 60
setpos 0 -300 0
setang 25 0 0
wait 90
shot wall_idle
host_timescale 0.02
wait 3
+attack
wait_for shot 3000
-attack
gwait 0.0167
shot wall_f01
gwait 0.0167
shot wall_f02
gwait 0.0167
shot wall_f03
gwait 0.0167
shot wall_f04
gwait 0.0167
shot wall_f05
gwait 0.0167
shot wall_f06
gwait 0.0167
shot wall_f07
gwait 0.0167
shot wall_f08
gwait 0.0167
shot wall_f09
gwait 0.0167
shot wall_f10
gwait 0.0167
shot wall_f11
gwait 0.0167
