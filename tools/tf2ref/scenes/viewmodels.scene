# Ours for viewmodels.tf2: every class's stock guns at rest, first person.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/viewmodels.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
# TF2 is watched in a puppet bot's eyes: a bot's FOV is 75 (TF2's
# default; measured: a spectator in its eyes saw what fov_desired 75 shows)
fov_desired 75
tf2_viewmodel_fov 54
rung tf2:tf_weapon_scattergun
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 180
shot scout_scattergun
rung tf2:tf_weapon_pistol_scout
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 180
shot scout_pistol
rung tf2:tf_weapon_bat
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 180
shot scout_bat
rung tf2:tf_weapon_rocketlauncher
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 180
shot soldier_rocketlauncher
