# Held weapons and motion pairs (ours: anim2.scene): each class's puppet bot
# facing the camera, idle with each slot 150 units away (the held c_
# models), then with its primary 300 away crouched (`bot_crouch`) and
# jumping (`bot_jump`, 0.15 and 0.4 s), a free spectator at an Engineer's
# eye. No run: over RCON nothing moves a puppet bot (`bot_moveto` needs a player's crosshair, `bot_mimic` a player's keys).
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/anim2.tf2 --out <dir>
cl_drawhud 0
r_drawvgui 0
tf_spec_xray 0
fov_desired 90
fps_max 60
host_framerate 0
mp_disable_respawn_times 1
tf_weapon_criticals 0
bot_kick all
sleep 2
jointeam spectator
sleep 2
# scout
bot_kick all
sleep 1
bot_selectweaponslot 0
bot -name RefScout -class scout -team blue
sleep 5
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
spec_mode 6
sleep 1
setpos 0 -150 68
setang 0 90 0
sleep 2
shot h_scout_0
setpos 0 -300 68
setang 0 90 0
sleep 1
bot_crouch 1
sleep 1.5
shot m_scout_crouch
bot_crouch 0
sleep 1
bot_jump 1
sleep 0.15
shot m_scout_jump1
sleep 0.25
shot m_scout_jump2
bot_jump 0
sleep 2
bot_kick all
sleep 1
bot_selectweaponslot 1
bot -name RefScout -class scout -team blue
sleep 5
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
spec_mode 6
sleep 1
setpos 0 -150 68
setang 0 90 0
sleep 2
shot h_scout_1
bot_kick all
sleep 1
bot_selectweaponslot 2
bot -name RefScout -class scout -team blue
sleep 5
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
spec_mode 6
sleep 1
setpos 0 -150 68
setang 0 90 0
sleep 2
shot h_scout_2
