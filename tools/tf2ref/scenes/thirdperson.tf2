snap tp_rocket_f03
wait 2
snap tp_rocket_f04
wait 2
snap tp_rocket_f05
wait 2
snap tp_rocket_f06
wait 2
snap tp_rocket_f07
wait 2
snap tp_rocket_f08
wait 2
snap tp_rocket_f09
wait 2
snap tp_rocket_f10
wait 2
snap tp_rocket_f11
wait 2
snap tp_rocket_f12
wait 2
snap tp_rocket_f13
wait 2
snap tp_rocket_f14
wait 2
snap tp_rocket_f15
bot_forceattack 0
wait 2
host_framerate 0
sleep 2
