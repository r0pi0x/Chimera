bot_selectweaponslot 0
bot -name RefPyro -class pyro -team blue
sleep 3
bot_teleport RefPyro 0 133 0 0 270 0
sleep 2
bot_teleport RefPyro 0 133 0 0 270 0
sleep 2
bot_teleport RefPyro 0 133 0 0 270 0
