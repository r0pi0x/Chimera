# Third-person looks on 2fort's bridge (real TF2; ours: thirdperson.scene): a
# puppet bot (stock guns) 433 units ahead (11 m) faces the camera and fires
# (`bot_forceattack`); we watch as a free spectator from the bridge. The muzzle
# flashes as others see them, the Rocket Launcher's backblast. 60 frames a
# second, a snap every 2 frames for 0.5 s.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/thirdperson.tf2 --out <dir>
cl_drawhud 0
r_drawvgui 0
fov_desired 90
fps_max 30
kick P1
sleep 2
jointeam spectator
sleep 2
spec_mode 6
# scattergun
kick P1
sleep 1
bot -name P1 -class scout -team blue
sleep 3
bot_teleport P1 0 133 0 0 270 0
setpos 0 -300 0
setang 0 90 0
sleep 2
shot tp_scattergun_idle
host_framerate 0.016667
bot_forceattack 1
wait 1
wait 2
snap tp_scattergun_f00
wait 2
snap tp_scattergun_f01
wait 2
snap tp_scattergun_f02
wait 2
snap tp_scattergun_f03
wait 2
snap tp_scattergun_f04
wait 2
snap tp_scattergun_f05
wait 2
snap tp_scattergun_f06
wait 2
snap tp_scattergun_f07
wait 2
snap tp_scattergun_f08
wait 2
snap tp_scattergun_f09
wait 2
snap tp_scattergun_f10
wait 2
snap tp_scattergun_f11
wait 2
snap tp_scattergun_f12
wait 2
snap tp_scattergun_f13
wait 2
snap tp_scattergun_f14
wait 2
snap tp_scattergun_f15
bot_forceattack 0
wait 2
host_framerate 0
sleep 2
# rocket
kick P1
sleep 1
