# Ours for launch.tf2: one shot each of the Rocket Launcher, the Grenade
# Launcher, the Stickybomb Launcher (tapped) and the Syringe Gun (a short
# burst) from 2fort's bridge, 10 degrees down along it, the view model
# drawn, a picture every 1/60 s of game time from the shot for 0.5 s.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +mat_hdr_level 2 +mat_colorcorrection 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/launch.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
rung tf2:tf_weapon_rocketlauncher
wait 2
wait_for idle 3000
wait 60
setpos 0 -300 0
setang 10 90 0
wait 90
shot rocket_idle
host_timescale 0.02
wait 3
+attack
wait_for shot 3000
-attack
gwait 0.0167
shot rocket_f01
gwait 0.0167
shot rocket_f02
gwait 0.0167
shot rocket_f03
gwait 0.0167
