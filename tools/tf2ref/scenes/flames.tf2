# TF2's Flame Thrower on 2fort's bridge (real TF2; ours: flames.scene): first
# person at the bridge's side wall and down the bridge (open air), then the
# same from a third-person camera. host_framerate 0.008, a snap every 4 frames
# (32 ms) for 1.3 s; pictures 0.5 and 1.0 s into the stream: f014, f030.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/flames.tf2 --out <dir>
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 30
joinclass pyro
kill
sleep 7
use tf_weapon_flamethrower
setpos 0 0 0
setang 10 0 0
sleep 3
shot flame_wall_idle
host_framerate 0.008
+attack
wait 1
wait 4
snap flame_wall_f000
wait 4
snap flame_wall_f001
wait 4
snap flame_wall_f002
wait 4
snap flame_wall_f003
wait 4
snap flame_wall_f004
wait 4
snap flame_wall_f005
wait 4
snap flame_wall_f006
wait 4
snap flame_wall_f007
wait 4
snap flame_wall_f008
