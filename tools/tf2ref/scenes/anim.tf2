# Bodies' animation on 2fort's bridge (real TF2; ours: anim.scene): each
# class's puppet bot 300 units (7.62 m) ahead faces the camera; idle with its
# primary, then jumping (`bot_jump`), crouched (`bot_crouch`); the Heavy also
# spun (`bot_forceattack2`) and firing. We watch as a free spectator from an
# Engineer's eye (68 units up), as thirdperson.tf2.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/anim.tf2 --out <dir>
cl_drawhud 0
r_drawvgui 0
tf_spec_xray 0
fov_desired 90
fps_max 60
host_framerate 0
mp_disable_respawn_times 1
tf_weapon_criticals 0
bot_kick all
sleep 2
jointeam spectator
sleep 2
# scout
bot_kick all
sleep 1
bot_selectweaponslot 0
bot -name RefScout -class scout -team blue
sleep 3
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
bot_teleport RefScout 0 0 0 0 270 0
sleep 2
bot_teleport RefScout 0 0 0 0 270 0
spec_mode 6
sleep 1
setpos 0 -300 68
setang 0 90 0
sleep 2
shot an_scout_idle
bot_crouch 1
sleep 1.5
shot an_scout_crouch
bot_crouch 0
sleep 1
bot_jump 1
sleep 0.15
shot an_scout_jump1
sleep 0.25
shot an_scout_jump2
bot_jump 0
sleep 2
