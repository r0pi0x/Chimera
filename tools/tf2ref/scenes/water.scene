# Ours for water.tf2: a rocket into the water under 2fort's bridge, flying
# (noclip) with the eye just above the surface, 45 degrees down; a picture
# every 1/60 s of game time from the shot; then the same with the eye
# under water (`wunder`), 30 degrees down.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/water.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
rung tf2:tf_weapon_rocketlauncher
wait 2
wait_for idle 3000
wait 60
noclip
setpos -400 0 -80
setang 45 0 0
wait 90
getpos
shot water_idle
host_timescale 0.02
wait 3
+attack
wait_for shot 3000
-attack
gwait 0.0167
shot water_f01
gwait 0.0167
shot water_f02
gwait 0.0167
shot water_f03
gwait 0.0167
shot water_f04
