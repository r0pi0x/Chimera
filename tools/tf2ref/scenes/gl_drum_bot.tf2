# TF2's stock Grenade Launcher's drum as others see it (third person;
# specs/tf2/weapons_more.md 9.6; the Demoman's own view: gl_drum.tf2): a
# puppet Demoman (stock guns) on the 2fort bridge empties the clip (attack
# held 2.5 s: four shots 0.6 s apart), then reloads all four (an empty clip
# reloads by itself; bots have no cl_autoreload); a roaming spectator
# looks at the drum's side from 35 units. Every frame at 60 fps
# (`host_framerate 0.016667`; `wait 2` is one frame here) as `gldb_NN`.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/gl_drum_bot.tf2 --out <dir>
mp_disable_respawn_times 1
tf_weapon_criticals 0
host_framerate 0
bot_kick all
sleep 3
bot -name GLB -class demoman -team blue
sleep 4
bot_teleport GLB 0 0 0 0 90 0
bot_selectweaponslot 0
sleep 2
jointeam spectator
sleep 2
spec_mode 6
sleep 1
setpos 38 30 56
setang 18 -150 0
cl_drawhud 0
r_drawvgui 0
sleep 3
host_framerate 0.016667
wait 4
movie gldb
wait 20
bot_forceattack 1
wait 300
bot_forceattack 0
wait 500
endmovie
host_framerate 0
