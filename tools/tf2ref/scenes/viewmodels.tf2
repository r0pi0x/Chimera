# Every class's stock guns in first person at rest on 2fort's bridge (real
# TF2; ours: viewmodels.scene): a puppet bot (stock loadout) per class,
# watched in its eyes (`spec_mode 4`), slots 1, 2 and 3 (`<class>_<gun>`).
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/viewmodels.tf2 --out <dir>
mp_disable_respawn_times 1
cl_drawhud 0
r_drawvgui 0
fov_desired 90
viewmodel_fov 54
fps_max 60
mat_colorcorrection 0
host_framerate 0
jointeam spectator
sleep 2
# scout
bot_kick all
sleep 2
bot_selectweaponslot 0
bot -name P1 -class scout -team red
sleep 3
bot_teleport P1 0 0 0 0 90 0
sleep 1
spec_player P1
sleep 1
spec_mode 4
sleep 1
bot_teleport P1 0 0 0 0 90 0
sleep 3
shot scout_scattergun
bot_selectweaponslot 1
sleep 3
bot_teleport P1 0 0 0 0 90 0
sleep 0.5
shot scout_pistol
bot_selectweaponslot 2
sleep 3
bot_teleport P1 0 0 0 0 90 0
sleep 0.5
shot scout_bat
