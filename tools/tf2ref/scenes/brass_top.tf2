# The Minigun's brass from 260 units above a puppet Heavy firing level (real
# TF2; ours: brass_top.scene): where the casings land beside him.
#   tools/tf2ref/tf2ref.py scene tools/tf2ref/scenes/brass_top.tf2 --out <dir>
cl_drawhud 0
r_drawvgui 0
tf_spec_xray 0
fov_desired 90
fps_max 60
mat_colorcorrection 0
host_framerate 0
mp_disable_respawn_times 1
tf_weapon_criticals 0
bot_kick all
sleep 2
jointeam spectator
sleep 2
spec_mode 6
# minigun
bot_kick all
sleep 1
bot_selectweaponslot 0
bot -name RefHeavy -class heavy -team blue
sleep 5
bot_teleport RefHeavy 0 133 0 0 270 0
sleep 2
bot_teleport RefHeavy 0 133 0 0 270 0
sleep 2
bot_teleport RefHeavy 0 133 0 0 270 0
spec_mode 6
sleep 1
setpos 0 133 260
setang 89 90 0
sleep 2
shot top_minigun_idle
host_framerate 0.016667
movie top_minigun
wait 2
bot_forceattack 1
wait 240
endmovie
bot_forceattack 0
wait 2
host_framerate 0
sleep 2
bot_kick all
