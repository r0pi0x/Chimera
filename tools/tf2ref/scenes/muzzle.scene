# Ours for muzzle.tf2 (first-person muzzle flashes on 2fort's bridge): pictures
# 8, 25, 42 and 58 ms (game time) after the shot (TF2's 60 fps frames: the
# shot's frame and the 3 after it), slowed to host_timescale 0.01.
#   ultimate_gun_game --offscreen 1024x768 +volume 0 +sandbox tf2:ctf_2fort --scene tools/tf2ref/scenes/muzzle.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 120
god
sandbox ammo on
cl_drawhud 0
fov_desired 90
tf2_viewmodel_fov 54
# scattergun
rung tf2:tf_weapon_scattergun
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 90
shot scattergun_idle
host_timescale 0.01
# the new rate holds from the next frames: a shot in this one ran
# at full speed (13 ms of its effects in one step)
wait 3
+attack
wait_for shot 3000
gwait 0.008
shot scattergun_m0
gwait 0.017
shot scattergun_m1
gwait 0.017
shot scattergun_m2
gwait 0.016
shot scattergun_m3
-attack
-attack2
host_timescale 1
wait 30
# pistol
rung tf2:tf_weapon_pistol_scout as tf2:engineer
wait 2
wait_for idle 3000
wait 60
setpos 0 0 0
setang 0 90 0
wait 90
