#!/usr/bin/env bash
# Refuse commits that break the build of what the staged changes can
# affect, or the fast tier of tests (unit tests and integration tests
# outside `heavy::`, docs/OBSERVABILITY.md section 1) of the packages
# whose files changed. `repo_checks`' `affected` maps the staged files to
# workspace packages and follows cargo's crate graph up to every package
# whose tests depend on them (checks/src/affected.rs has the rules: the
# workspace manifest, .config/, the hooks or a build.rs select everything;
# the lockfile the crates whose resolved dependencies changed; Markdown
# and docs only the repository checks; a data file the tests of what
# reads it, with nothing to type-check). The hook checks the tests of
# all of those whose code changed (`affected --code`; `cargo check --all-targets`: type-checks every target
# without codegen or linking; CHIMERA_COMMIT_DEPENDENTS=build restores the
# old full build of their test binaries) and runs only the changed
# packages' own (`affected --direct`) and repo_checks'; the dependents'
# tests, and the heavy ones, run after the push (tools/post-push-tests.sh).
# On Linux the type-check runs beside the fast tier (the tests are built,
# then their binaries run directly while cargo checks; doctests after),
# and leaves out the packages the fast tier builds anyway;
# CHIMERA_COMMIT_FAST=0 runs them one after the other as before. Each run
# logs its phases' seconds to <git common dir>/agent-timing/commit-hook.log.
# CHIMERA_COMMIT_TESTS=affected runs every affected package's fast tier
# (the old behaviour); =all the whole fast tier; =0 skips it (the old
# name, MASHUP_COMMIT_TESTS, still works).
#
# Run it yourself before committing, on the working tree:
#
#   .githooks/pre-commit --worktree
#
# selects from every change against HEAD (staged, unstaged and untracked
# files), runs the same checks and tests, and on a pass records a stamp.
# The hook itself stamps its passes too. A commit whose working tree is
# exactly the one a stamp passed on (the tracked files' tree, the
# untracked files' names, sizes and times), with the same toolchain,
# mode, features and CHIMERA_* settings, and whose selection the stamp's
# covers, is not tested again: the hook says so and which stamp. Any
# difference runs the tests as before (the hook has always tested the
# working tree, not the index alone: the stamp checks the same thing).
# Stamps: <git common dir>/test-stamps, the newest 100 kept.
# CHIMERA_COMMIT_STAMPS=0 ignores them.
#
# In an agent checkout (.claude/worktrees, .claude/slots) cargo runs with
# tools/agent-env.sh's settings, as the agents' own builds do, so the
# hook reuses their build instead of making a second one.
# Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify
mode=${CHIMERA_COMMIT_TESTS:-${MASHUP_COMMIT_TESTS:-changed}}
worktree=0
[ "${1:-}" = --worktree ] && worktree=1
[ "$mode" = 0 ] && [ "$worktree" = 0 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ "$worktree" = 1 ]; then
    # Every change against HEAD: tracked (staged or not), deleted and
    # untracked files.
    mapfile -t changed < <({ git diff HEAD --name-only; git ls-files --others --exclude-standard; } | sort -u)
    if [ "${#changed[@]}" = 0 ]; then
        echo "pre-commit --worktree: no changes against HEAD; nothing to test." >&2
        exit 0
    fi
    changes=(--files "${changed[@]}")
    who="pre-commit --worktree"
else
    if [ -z "$(git diff --cached --name-only)" ]; then
        exit 0
    fi
    changes=(--staged)
    who="pre-commit"
fi
case "$PWD" in
    */.claude/worktrees/*|*/.claude/slots/*)
        # shellcheck source=/dev/null
        [ -z "${AGENT_ENV:-}" ] && [ -f tools/agent-env.sh ] && . tools/agent-env.sh ;;
esac
run() { if command -v agent_run >/dev/null 2>&1; then agent_run "$@"; else "$@"; fi; }
mkdir -p target
# Each run's time and outcome, for tools/agent-timing (<git common
# dir>/agent-timing/commit-hook.log, the newest 2000 lines kept).
started=$(date +%s)
timing() { # <outcome>
    local d
    d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/agent-timing || return 0
    mkdir -p "$d" 2>/dev/null || return 0
    # Columns: UTC time, seconds, outcome, who, packages tested, then the
    # phases' seconds: the type-check of the affected tests, the fast tier
    # (build and run; the two overlap when the check ran beside the tests).
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(( $(date +%s) - started ))" "$1" "$who" "$(pkgs "${tests:-}" | wc -l)" "${check_s:--}" "${test_s:--}" >>"$d/commit-hook.log"
    if [ "$(wc -l <"$d/commit-hook.log")" -gt 2500 ]; then
        tail -n 2000 "$d/commit-hook.log" >"$d/commit-hook.log.$$" && mv -f "$d/commit-hook.log.$$" "$d/commit-hook.log"
    fi
}
log=target/pre-commit.log
# The selection, one argument per line (`affected` prints them so; extra
# options in "$@"); fails when it can't select (then the whole workspace).
pick() {
    run cargo run --quiet -p repo_checks --bin affected -- "${changes[@]}" --format cargo "$@" 2>target/pre-commit-affected.txt
}
if [ "$mode" = all ]; then
    build=--workspace
    tests=--workspace
    echo "$who: CHIMERA_COMMIT_TESTS=all: the whole fast tier" >&2
elif ! build=$(pick); then
    cat target/pre-commit-affected.txt >&2
    echo "$who: couldn't select the affected tests; running the whole fast tier." >&2
    build=--workspace
    tests=--workspace
else
    sed "s/^/$who: /" target/pre-commit-affected.txt >&2
    if [ "$mode" = affected ]; then
        tests=$build
    elif ! tests=$(pick --direct --quiet); then
        tests=$build
    fi
fi

# What to type-check: the selection without its data files (`affected
# --code`): a data document is read at run time in a dev build, so no
# dependent's code can stop compiling for it (only its tests can change).
checks=$build
if [ "$build" != --workspace ] && c=$(pick --code --quiet); then
    checks=$c
fi

# --- Pass stamps (.githooks/stamps.sh) -------------------------------------
dependents=${CHIMERA_COMMIT_DEPENDENTS:-check}
# shellcheck source=.githooks/stamps.sh
. "$(dirname "${BASH_SOURCE[0]}")/stamps.sh"
key=
if [ "${CHIMERA_COMMIT_STAMPS:-1}" != 0 ]; then
    key=$(tree_key) || key=
fi
if [ -n "$key" ] && [ -f "$stamps/$key" ]; then
    if covered "$(pkgs "$tests")" "$(stamp_tested "$key")" && covered "$(pkgs "$checks")" "$(stamp_checked "$key")"; then
        echo "$who: this exact working tree already passed these checks and fast tests ($(sed -n 's/^when //p' "$stamps/$key"), stamp $stamps/$key); not running them again (CHIMERA_COMMIT_STAMPS=0 does)." >&2
        touch "$stamps/$key"
        timing stamp
        exit 0
    fi
    echo "$who: a stamp for this working tree covers fewer packages; testing." >&2
fi

set -f
IFS='
'
# shellcheck disable=SC2086
set -- $tests
unset IFS
tests_args=("$@")
# The type-check of the affected tests ($checks), less the packages the
# fast tier builds anyway (`cargo test` builds their libs, bins, tests and
# examples: checking them too was the same work twice). A package a
# feature argument names stays (the feature needs it selected).
check_args=()
if [ "$checks" != "$tests" ]; then
    IFS='
'
    # shellcheck disable=SC2086
    set -- $checks
    unset IFS
    if [ "${CHIMERA_COMMIT_FAST:-1}" = 0 ] || [ "$dependents" = build ]; then
        check_args=("$@")
    else
        tested=$(pkgs "$tests")
        while [ $# -gt 0 ]; do
            if [ "$1" = -p ] && grep -qx -- "$2" <<<"$tested" && ! grep -qE -- "(^|[ ,])$2/" <<<"$checks"; then
                shift 2; continue
            fi
            check_args+=("$1"); shift
        done
        # Nothing left but options: no package to check.
        printf '%s\n' "${check_args[@]}" | grep -qx -- '-p\|--workspace' || check_args=()
    fi
fi
check_cmd=
if [ "${#check_args[@]}" -gt 0 ]; then
    if [ "$dependents" = build ]; then
        check_cmd="cargo test ${check_args[*]} --features dev --quiet --no-run"
    else
        check_cmd="cargo check ${check_args[*]} --features dev --quiet --all-targets"
    fi
fi
check_fail() {
    grep -E "^error" -A6 "$log.check" | head -30
    echo "$who: the affected tests don't $([ "$dependents" = build ] && echo build || echo check) (full log: $log.check; CHIMERA_COMMIT_DEPENDENTS=build builds them); not committing." >&2
    timing fail
    exit 1
}
# The runner: CHIMERA_COMMIT_RUNNER=nextest runs the fast tier under
# `cargo nextest run` (binaries side by side) plus `cargo test --doc` for
# the doctests nextest skips; =cargo (the default, and wherever nextest
# isn't installed) runs `cargo test`. Both run the same tests.
runner=${CHIMERA_COMMIT_RUNNER:-cargo}
[ "$runner" = nextest ] && ! cargo nextest --version >/dev/null 2>&1 && runner=cargo
# The check beside the tests (Linux with python3; CHIMERA_COMMIT_FAST=0
# turns it off): cargo holds its locks while `cargo test` runs the
# tests, so a second cargo waits for them. Instead the tests are built
# (`cargo test --no-run`), the check starts, and the test binaries run
# directly while it checks, each as `cargo test` runs it (in its
# package's folder, with its CARGO_MANIFEST_DIR and the library path);
# the doctests (`cargo test --doc`) run after the check.
overlap=0
if [ -n "$check_cmd" ] && [ "$runner" = cargo ] && [ "${CHIMERA_COMMIT_FAST:-1}" != 0 ] \
    && [ "$(uname -s)" = Linux ] && command -v python3 >/dev/null 2>&1; then
    overlap=1
fi
t_args="${tests_args[*]}"
if [ "$runner" = nextest ]; then
    cmds=("cargo nextest run $t_args --features dev --no-fail-fast --no-tests=pass --color never -E '!test(/heavy::/)'"
          "cargo test --doc $t_args --features dev --quiet --no-fail-fast")
elif [ "$overlap" = 1 ]; then
    cmds=("cargo test $t_args --features dev --no-run, then each test binary with --skip heavy:: --quiet"
          "cargo test --doc $t_args --features dev --quiet --no-fail-fast")
else
    cmds=("cargo test $t_args --features dev --quiet --no-fail-fast -- --skip heavy::")
fi
: >"$log"
: >"$log.check"
check_s=- test_s=-
if [ -n "$check_cmd" ]; then
    if [ "$overlap" = 1 ]; then
        echo "$who: checking the affected tests beside the fast tier:" >&2
    else
        echo "$who: checking the affected tests:" >&2
    fi
    echo "$who:   $check_cmd" >&2
fi
echo "$who: running the fast tier of: $t_args" >&2
for c in "${cmds[@]}"; do echo "$who:   $c" >&2; done
doc_tests() { # doctests; a selection without a library has none
    run cargo test --doc "${tests_args[@]}" --features dev --quiet --no-fail-fast >>"$log" 2>&1 && return 0
    tail -n 3 "$log" | grep -q "no library targets found"
}
tested_ok=1
if [ -n "$check_cmd" ] && [ "$overlap" = 0 ]; then
    t0=$(date +%s)
    # shellcheck disable=SC2086
    run $check_cmd >"$log.check" 2>&1 || check_fail
    check_s=$(( $(date +%s) - t0 ))
fi
t0=$(date +%s)
if [ "$runner" = nextest ]; then
    run cargo nextest run "${tests_args[@]}" --features dev --no-fail-fast --no-tests=pass --color never -E '!test(/heavy::/)' >>"$log" 2>&1 || tested_ok=0
    doc_tests || tested_ok=0
elif [ "$overlap" = 1 ]; then
    json=target/pre-commit-tests.json
    if ! run cargo test "${tests_args[@]}" --features dev --no-run --message-format=json-render-diagnostics >"$json" 2>>"$log"; then
        grep -E "^error" -A6 "$log" | head -30
        echo "$who: the fast tier doesn't build (full log: $log); not committing." >&2
        timing fail
        exit 1
    fi
    c0=$(date +%s)
    # shellcheck disable=SC2086
    ( run $check_cmd >"$log.check" 2>&1; echo $? >"$log.check.rc"; echo $(( $(date +%s) - c0 )) >"$log.check.s" ) &
    check_pid=$!
    # The test binaries (lib, bins, tests, examples' tests), their
    # packages' folders and the build scripts' library folders.
    libpath=$(python3 -I - "$json" <<'PY'
import json, sys
paths = []
for line in open(sys.argv[1]):
    try: m = json.loads(line)
    except ValueError: continue
    if m.get("reason") == "build-script-executed":
        for p in m.get("linked_paths", []):
            p = p.split("=", 1)[-1]
            if p not in paths: paths.append(p)
print(":".join(paths))
PY
)
    out=$(dirname "$(python3 -I - "$json" <<'PY'
import json, sys
for line in open(sys.argv[1]):
    try: m = json.loads(line)
    except ValueError: continue
    if m.get("reason") == "compiler-artifact" and m.get("executable") and "/build/" not in m["executable"]:
        print(m["executable"]); break
PY
)")
    sysroot=$(rustc --print sysroot)
    while IFS=$'\t' read -r exe manifest pkg; do
        [ -n "$exe" ] || continue
        echo "     Running $exe" >>"$log"
        ( cd "$(dirname "$manifest")" && CARGO=$(command -v cargo) CARGO_MANIFEST_DIR=$(dirname "$manifest") \
            CARGO_MANIFEST_PATH=$manifest CARGO_PKG_NAME=$pkg \
            LD_LIBRARY_PATH="$out:$out/deps:$(dirname "$out")/deps:$(dirname "$out")${libpath:+:$libpath}:$sysroot/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            "$exe" --skip heavy:: --quiet ) >>"$log" 2>&1 || tested_ok=0
    done < <(python3 -I - "$json" <<'PY'
import json, sys, tomllib
names = {}
for line in open(sys.argv[1]):
    try: m = json.loads(line)
    except ValueError: continue
    if m.get("reason") == "compiler-artifact" and m.get("executable") and m.get("profile", {}).get("test"):
        mp = m["manifest_path"]
        if mp not in names:
            with open(mp, "rb") as f: names[mp] = tomllib.load(f)["package"]["name"]
        print(f"{m['executable']}\t{mp}\t{names[mp]}")
PY
)
    test_s=$(( $(date +%s) - t0 ))
    wait "$check_pid"
    check_s=$(cat "$log.check.s" 2>/dev/null || echo -)
    [ "$(cat "$log.check.rc" 2>/dev/null)" = 0 ] || check_fail
    t1=$(date +%s)
    doc_tests || tested_ok=0
    test_s=$(( test_s + $(date +%s) - t1 ))
else
    run cargo test "${tests_args[@]}" --features dev --quiet --no-fail-fast -- --skip heavy:: >>"$log" 2>&1 || tested_ok=0
fi
[ "$test_s" = - ] && test_s=$(( $(date +%s) - t0 ))
if [ "$tested_ok" = 0 ]; then
    grep -E "panicked|FAILED|FAIL \[|^error" "$log" | head -20
    echo "$who: fast tests failed (full log: $log); not committing." >&2
    timing fail
    exit 1
fi
stamp_record "$key" "$who" "$(pkgs "$tests")" "$(pkgs "$checks")"
timing pass
if [ "$worktree" = 1 ]; then
    names() { pkgs "$1" | sed 's/^\*$/the workspace/' | paste -sd' ' -; }
    checked=
    [ "$checks" != "$tests" ] && [ -n "$check_cmd" ] && checked="type-checked the tests of $(names "$checks") ($check_s s) and "
    echo "$who: passed in $(( $(date +%s) - started )) s: ${checked}ran the fast tier of $(names "$tests") ($test_s s; heavy tests run after the push). Stamped: a commit of this exact working tree skips these." >&2
fi
exit 0
