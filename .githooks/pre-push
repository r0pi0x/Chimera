#!/usr/bin/env bash
# Refuse to push commits whose dates aren't UTC or whose author/committer
# isn't the repo's identity: commit metadata stays anonymous (CLAUDE.md,
# "Commit identity"). Fix with TZ=UTC and the repo-local user.name/email,
# then amend or rebase the listed commits. Refuse personal traces (machine
# paths, .githooks/private-patterns) in what's pushed, and a push while the
# repository checks (`cargo test -p repo_checks`: layering, the asset and
# spec rules, the docs) fail.
# Push first, test after: the tests of every package the push can affect
# (heavy ones too), the build without --features dev, the dedicated
# servers' builds and the workspace-hack run after the push, in their own
# warm checkout: `tools/post-push-tests.sh` (CHIMERA_PUSH_TESTS=all|0 is
# read there). The pre-commit hook has already built what each commit can
# affect and run its changed packages' fast tier.
want_name=r0pi0x
want_email=339403489+r0pi0x@users.noreply.github.com
zero=0000000000000000000000000000000000000000
bad=0
pushing=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    pushing=1
    if [ "$remote_sha" = "$zero" ]; then
        # A new ref (a branch or tag the remote lacks): only the commits
        # the remote doesn't have yet, not the whole published history.
        range="$local_sha --not --remotes"
    else
        range="$remote_sha..$local_sha"
    fi
    out=$(git log --format='%h %an|%ae|%ad|%cn|%ce|%cd' --date=format:%z $range |
        awk -F'|' -v n="$want_name" -v e="$want_email" '{
            split($1, a, " "); an = substr($1, length(a[1]) + 2)
            if (an != n || $2 != e || $3 != "+0000" || $4 != n || $5 != e || $6 != "+0000") print
        }')
    if [ -n "$out" ]; then
        echo "pre-push: these commits aren't by $want_name <$want_email> in UTC:" >&2
        echo "$out" >&2
        bad=1
    fi
    # Personal traces in what's being pushed (commit messages and added
    # lines): machine paths always, plus the case-insensitive patterns in
    # the git-ignored .githooks/private-patterns (one extended regex per
    # line, e.g. a real name), so the names themselves are never committed.
    patterns='/home/[A-Za-z0-9_.-]+/|/Users/[A-Za-z0-9_.-]+/|[A-Za-z]:\\+Users\\+[A-Za-z0-9_.-]'
    if [ -f .githooks/private-patterns ]; then
        extra=$(grep -v -e '^#' -e '^[[:space:]]*$' .githooks/private-patterns | paste -sd'|' -)
        [ -n "$extra" ] && patterns="$patterns|$extra"
    fi
    hits=$(git log -p --no-color --format='%n%B' $range | grep -E -i -n -e "^\+.*($patterns)" -e "^[^-+@ ].*($patterns)" | grep -v '^[0-9]*:+++ ' | head -10)
    if [ -n "$hits" ]; then
        echo "pre-push: personal traces (paths or private patterns) in what's being pushed:" >&2
        echo "$hits" | cut -c1-160 >&2
        bad=1
    fi
done
if [ "$bad" = 1 ]; then
    echo "pre-push: fix the commits above (TZ=UTC and the repo-local identity; remove personal traces), then amend/rebase them; not pushing." >&2
    exit 1
fi
if [ "$pushing" = 1 ]; then
    case "$PWD" in
        */.claude/worktrees/*|*/.claude/slots/*)
            # shellcheck source=/dev/null
            [ -z "${AGENT_ENV:-}" ] && [ -f tools/agent-env.sh ] && . tools/agent-env.sh ;;
    esac
    run() { if command -v agent_run >/dev/null 2>&1; then agent_run "$@"; else "$@"; fi; }
    mkdir -p target
    echo "pre-push: the repository checks (cargo test -p repo_checks)..." >&2
    if ! run cargo test -p repo_checks --quiet >target/pre-push.log 2>&1; then
        grep -E "panicked|FAILED|^error" target/pre-push.log | head -20
        echo "pre-push: the repository checks fail (log: target/pre-push.log); not pushing." >&2
        exit 1
    fi
    echo "pre-push: pushed untested beyond that: run tools/post-push-tests.sh now (it tests the pushed main in .claude/slots/post-push)." >&2
fi

# Keep this clone's build folder from growing without bound: cargo never
# deletes the artifacts of older code, feature sets or renamed crates
# (it reached 580 GB). Drop the oldest ones beyond 150 GB, quietly, when
# cargo-sweep is installed (`cargo install cargo-sweep`). sccache keeps the
# compile cache separately, so nothing here is needed to build fast.
if command -v cargo-sweep >/dev/null 2>&1 || [ -x "$HOME/.cargo/bin/cargo-sweep" ]; then
    PATH="$HOME/.cargo/bin:$PATH" cargo sweep --maxsize 150GB . >/dev/null 2>&1 || true
fi
