# The Hunter's cannon on another game's map (a scene script: chimera_client's
# `scene`; the body and its cannon's unit are the `character/hunter` set,
# game::campaign::unit; its effects join Halo's on the map's load,
# game::fx::load::own_weapons): a Hunter target fires at the player, who
# faces it 11 m away (god mode): the rods come at the eye and burst on the
# player. Pictures: a rod
# in flight (frames after a shot) and its blast (frames after one).
#   cargo run --features dev --bin ultimate_gun_game -- --offscreen 1600x900 +volume 0 +sandbox cs_source:de_dust2 \
#       --scene apps/ultimate_gun_game/scenes/hunter_cannon_dust2.scene --out <dir>
wait_for map_loaded 6000
wait_for spawned 3000
wait 1500                    # the units in, pipelines settled
god
rung halo_ce:plasma_pistol   # a Halo gun in the player's hands
setpos -82 -555 208          # the T side, a double door 12 m ahead
setang 2 4
target add halo_ce:hunter 11
target set all gun halo_ce:hunter_fuel_rod
wait 300                     # its unit loaded and worn
halo_ce:body status
target set all shoots
shot_after shot 12 rod_flight_a
shot_after shot 24 rod_flight_b
shot_after blast 1 rod_blast_a
shot_after blast 20 rod_blast_b
wait 400
target list
